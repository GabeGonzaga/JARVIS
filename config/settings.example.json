{
  "llm": {
    "provider": "ollama",
    "model": "qwen3:4b"
  },
  "security": {
    "require_master_password": true,
    "auth_window_seconds": 60
  },
  "file_access": {
    "allowed_roots": [
      "~/Desktop",
      "~/Documents"
    ]
  },
  "tool_permissions": {
    "macos.open_app": true,
    "macos.open_url": true,
    "macos.create_note": true,

    "system.list_dir": true,
    "system.read_file": true,

    "system.write_file": false,
    "system.delete_file": false
  }
}
